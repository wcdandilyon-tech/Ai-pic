# Port for the web UI
PORT=3000
# pollinations (hosted, free, no GPU needed), a1111 (your own AUTOMATIC1111 /
# SD WebUI Forge started with --api), or mock
BACKEND=pollinations
POLLINATIONS_MODEL=flux
A1111_URL=http://127.0.0.1:7860
# NSFW toggle is shown by default. Set to false to hide it.
# Adults only; minors are always blocked.
ALLOW_NSFW=true
